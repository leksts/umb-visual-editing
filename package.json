{
  "name": "umb-visual-editing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "cms": "node scripts/cms.mjs",
    "web:dev": "astro dev --root web",
    "web:build": "astro build --root web",
    "web:start": "node web/dist/server/entry.mjs",
    "backoffice:build": "vite build --config backoffice/vite.config.ts",
    "typecheck": "astro check --root web && tsc -p backoffice --noEmit",
    "test": "node scripts/test.mjs all",
    "test:web": "node scripts/test.mjs web",
    "test:api": "node scripts/test.mjs api",
    "test:e2e": "node scripts/test.mjs e2e"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@astrojs/vue": "^7.1.6",
    "astro": "^7.4.13",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@umbraco-cms/backoffice": "^18.3.2",
    "typescript": "5.9"
  }
}
