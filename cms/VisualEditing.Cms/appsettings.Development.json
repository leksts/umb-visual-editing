{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Test Editor",
        "UnattendedUserEmail": "editor@visualediting.test",
        "UnattendedUserPassword": "VisualEditing!2026",
        "UnattendedTelemetryLevel": "Minimal"
      },
      "Hosting": {
        "Debug": true
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "ApiKey": "local-dev-preview-key"
      }
    }
  },
  "VisualEditing": {
    "Enabled": true,
    "FrontendUrl": "http://localhost:4321",
    "AllowedFrontendOrigins": [
      "http://localhost:4321"
    ],
    "PreviewSecret": "local-dev-preview-secret-change-me",
    "TokenLifetimeMinutes": 60,
    "DocumentTypes": [
      "home",
      "article"
    ]
  }
}